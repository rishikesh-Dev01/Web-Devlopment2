<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Users</title>
    <style>
        table tr td {
            border: 1px solid aquamarine;
            background-color: darkgrey;
        }
    </style>
</head>
<body>
    <table>
      <tr>
        <td>Id</td>
        <td>Username</td> 
        <td>Email</td>
    </tr>
    <% for(user of users) { %> 
    <tr>
        <td> <%= user.id %> </td>
        <td> <%= user.email %> </td>
        <td> <%= user.username %> </td>
        <td>
            <form method="GET" action="/user/<%=user.id%>/edit">
            <button>Edit username</button>
        </form>
        </td>
    </tr>
  <% } %>
        </table>
</body>
</html>

