<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit your Chats</title>
  
</head>
<body>
    <p>Edit your chat: <%= chat._id %></p>
    <p>This chat was sent from <b><%= chat.from %></b> to <b><%= chat.to %></b></p>
    <form action="/chats/<%= chat._id %>?_method=PUT" method="POST">
        <textarea name="message" id="" rows="6" cols="50"><%= chat.message %></textarea>
        <br>
        <button>Edit button</button>
    </form>
</body>
</html>